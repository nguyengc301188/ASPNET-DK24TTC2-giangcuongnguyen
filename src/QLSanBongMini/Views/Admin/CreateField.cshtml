@model QLSanBongMini.Models.Field

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewBag.Title = "Thêm sân mới";
    ViewBag.Active = "Fields";
}

<h2>Thêm sân mới</h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()


    <div class="form-group mb-3">
        @Html.LabelFor(m => m.FieldName, "Tên sân")
        @Html.TextBoxFor(m => m.FieldName, new { @class = "form-control", placeholder = "Nhập tên sân" })
    </div>

    <div class="form-group mb-3">
        @Html.LabelFor(m => m.Address, "Địa chỉ")
        @Html.TextBoxFor(m => m.Address, new { @class = "form-control", placeholder = "Nhập địa chỉ sân" })
    </div>

    <div class="form-group mb-3">
        @Html.LabelFor(m => m.Type, "Loại sân")
        @Html.TextBoxFor(m => m.Type, new { @class = "form-control", placeholder = "Ví dụ: Sân cỏ nhân tạo 5 người" })
    </div>

    <div class="form-group mb-3">
        @Html.LabelFor(m => m.PricePerHour, "Giá mỗi giờ")
        @Html.TextBoxFor(m => m.PricePerHour, new { @class = "form-control", placeholder = "Nhập giá/giờ" })
    </div>

    <div class="form-group mb-3">
        @Html.LabelFor(m => m.Description, "Mô tả")
        @Html.TextAreaFor(m => m.Description, new { @class = "form-control", rows = 3, placeholder = "Mô tả chi tiết về sân..." })
    </div>

    <div class="form-group mb-3">
        @Html.LabelFor(m => m.ImageURL, "URL hình ảnh")
        @Html.TextBoxFor(m => m.ImageURL, new { @class = "form-control", placeholder = "Nhập URL hình ảnh sân" })
    </div>

    <div class="form-check mb-3">
        @Html.CheckBoxFor(m => m.Status, new { @class = "form-check-input" })
        @Html.LabelFor(m => m.Status, "Hiển thị sân", new { @class = "form-check-label" })
    </div>

    <button type="submit" class="btn btn-success">Thêm sân</button>
    <a href="@Url.Action("Fields", "Admin")" class="btn btn-secondary">Hủy</a>


}
