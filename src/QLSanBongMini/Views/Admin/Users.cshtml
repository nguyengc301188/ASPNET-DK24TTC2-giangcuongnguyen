@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewBag.Title = "Quản lý User";
    ViewBag.Active = "User";
}

@model IEnumerable<QLSanBongMini.Models.User>

<h2>Quản lý User</h2>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Họ tên</th>
            <th>Số điện thoại</th>
            <th>Trạng thái</th>
            <th>Hành động</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var u in Model)
        {
            <tr>
                <td>@u.FullName</td>
                <td>@u.Phone</td>
                <td>@(u.Status ? "Hoạt động" : "Đã khóa")</td>
                <td>
                    <a class="btn btn-sm btn-warning" href="@Url.Action("ToggleUserStatus", new { id = u.userID })">
                        @(u.Status ? "Khóa" : "Mở")
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
