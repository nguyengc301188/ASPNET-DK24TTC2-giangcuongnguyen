@model QLSanBongMini.Models.Field

<h2>@Model.FieldName</h2>
<img src="@Model.ImageURL" style="width:400px; height:250px; object-fit:cover;" />
<p>Địa chỉ: @Model.Address</p>
<p>Loại sân: @Model.Type</p>
<p>Giá/giờ: @Model.PricePerHour.ToString("N0") đ</p>

@if (Session["UserID"] != null)
{
    <h3>Đặt sân</h3>
    using (Html.BeginForm("BookField", "Home", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        @Html.Hidden("fieldID", Model.FieldID)

        <div class="form-group">
            <label>Ngày đặt</label>
            <input type="date" name="date" class="form-control" required />
        </div>
        <div class="form-group">
            <label>Giờ bắt đầu</label>
            <input type="time" name="startTime" class="form-control" required />
        </div>
        <div class="form-group">
            <label>Giờ kết thúc</label>
            <input type="time" name="endTime" class="form-control" required />
        </div>
        <button type="submit" class="btn btn-success">Đặt sân</button>
    }
}
else
{
    <p><a href="@Url.Action("Login", "AuthClient")">Đăng nhập</a> để đặt sân</p>
}
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
