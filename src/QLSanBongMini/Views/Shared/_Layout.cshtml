<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewBag.Title - Đặt sân bóng mini</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.1/dist/css/bootstrap.min.css">
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
        <div class="container-fluid">
            <a class="navbar-brand" href="@Url.Action("Index", "Home")">Website Quản lý Sân Bóng Mini</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    @if (Session["UserID"] != null && Session["Role"] != null && (int)Session["Role"] == 1)
                    {
                        @* ADMIN MENU *@
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Index", "Admin")">Dashboard</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Fields", "Admin")">Quản lý sân</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Bookings", "Admin")">Quản lý Booking</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Users", "Admin")">Quản lý User</a>
                        </li>
                        <li class="nav-item">
                            <span class="nav-link">Chào mừng, @Session["FullName"] (Admin)</span>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Logout", "AuthClient")">Đăng xuất</a>
                        </li>
                    }
                    else if (Session["UserID"] != null)
                    {
                        @* USER MENU *@
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Index", "Home")">Trang chủ</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Index", "Home")#fields">Xem sân</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Contact", "Home")">Liên hệ</a>
                        </li>
                        <li class="nav-item">
                            <span class="nav-link">Chào mừng, @Session["FullName"]</span>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("BookingHistory","Home")">Lịch sử đặt sân</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Logout", "AuthClient")">Đăng xuất</a>
                        </li>
                    }
                    else
                    {
                        @* GUEST MENU *@
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Index", "Home")">Trang chủ</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Index", "Home")#fields">Xem sân</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Contact", "Home")">Liên hệ</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Login", "AuthClient")">Đăng nhập</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Register", "AuthClient")">Đăng ký</a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <div class="container mt-4">
        @RenderBody()
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.1/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
