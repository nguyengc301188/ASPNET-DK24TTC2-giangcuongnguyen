@model QLSanBongMini.Models.Field

<h2>Sửa thông tin sân</h2>

@using (Html.BeginForm())
{
    @Html.HiddenFor(m => m.FieldID)

    <div class="form-group">
        <label>Tên sân</label>
        @Html.TextBoxFor(m => m.FieldName, new { @class = "form-control" })
    </div>

    <div class="form-group">
        <label>Giá mỗi giờ</label>
        @Html.TextBoxFor(m => m.PricePerHour, new { @class = "form-control" })
    </div>

    <div class="form-group">
        <label>Mô tả</label>
        @Html.TextAreaFor(m => m.Description, new { @class = "form-control" })
    </div>

    <div class="form-group">
        <label>Hình ảnh sân hiện tại</label><br />
        @if (!string.IsNullOrEmpty(Model.ImageURL))
        {
            <img src="@Model.ImageURL" style="width:200px; height:120px; object-fit:cover;" />
        }
    </div>

    <div class="form-group">
        <label>Thay đổi hình ảnh</label>
        <input type="file" name="ImageFile" class="form-control" />
    </div>


    <button type="submit" class="btn btn-primary">Lưu</button>
}
